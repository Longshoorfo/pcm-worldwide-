
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="PCM Worldwide is a global learning platform for Physics, Chemistry and Mathematics students.">
<title>PCM Worldwide | Global Learning Platform</title>

<style>
:root {
  --navy: #10243d;
  --blue: #1769aa;
  --light: #f1f5f9;
  --white: #ffffff;
  --text: #1b2b40;
  --muted: #64748b;
  --border: #dce4ec;
  --green: #16866b;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html { scroll-behavior: smooth; }

body {
  font-family: Arial, sans-serif;
  background: var(--light);
  color: var(--text);
  line-height: 1.6;
}

a { text-decoration: none; }

header {
  background: var(--navy);
  color: white;
  padding: 16px 6%;
  position: sticky;
  top: 0;
  z-index: 10;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 21px;
  font-weight: bold;
  letter-spacing: .5px;
}

.brand-mark {
  width: 38px;
  height: 38px;
  border: 2px solid #8cc5ee;
  border-radius: 10px;
  display: grid;
  place-items: center;
  color: #8cc5ee;
  font-size: 20px;
}

.nav-links {
  display: flex;
  gap: 22px;
  flex-wrap: wrap;
}

.nav-links a {
  color: #dce9f6;
  font-size: 14px;
}

.nav-links a:hover { color: white; }

.hero {
  background: linear-gradient(120deg, #10243d, #174f7c);
  color: white;
  padding: 85px 7%;
}

.hero-content { max-width: 760px; }

.eyebrow {
  color: #9dc8eb;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.hero h1 {
  font-size: clamp(36px, 6vw, 58px);
  line-height: 1.12;
  margin: 18px 0;
}

.hero p {
  color: #d2dfec;
  max-width: 600px;
  font-size: 17px;
  margin-bottom: 28px;
}

.primary-btn {
  display: inline-block;
  background: white;
  color: var(--navy);
  padding: 13px 22px;
  border-radius: 7px;
  font-weight: bold;
}

.secondary-btn {
  display: inline-block;
  border: 1px solid #9dc8eb;
  color: white;
  padding: 12px 22px;
  border-radius: 7px;
  margin-left: 10px;
}

section {
  padding: 65px 7%;
  scroll-margin-top: 75px;
}

.section-heading {
  margin-bottom: 28px;
}

.section-heading h2 {
  font-size: 29px;
  color: var(--navy);
}

.section-heading p {
  color: var(--muted);
  margin-top: 7px;
}

.subject-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}

.subject-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 26px;
  transition: transform .2s;
}

.subject-card:hover {
  transform: translateY(-4px);
}

.subject-symbol {
  color: var(--blue);
  font-size: 28px;
  font-weight: bold;
  margin-bottom: 15px;
}

.subject-card h3 {
  color: var(--navy);
  margin-bottom: 9px;
}

.subject-card p {
  color: var(--muted);
  font-size: 14px;
}

.text-link {
  display: inline-block;
  color: var(--blue);
  font-weight: bold;
  margin-top: 18px;
}

.ai-section {
  background: var(--navy);
  color: white;
}

.ai-section .section-heading h2 { color: white; }
.ai-section .section-heading p { color: #b9c9da; }

.ai-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 35px;
  align-items: center;
}

.ai-description h3 {
  font-size: 25px;
  margin-bottom: 14px;
}

.ai-description p {
  color: #c5d3e2;
  margin-bottom: 14px;
}

.ai-features {
  padding-left: 20px;
  color: #d5e4f2;
  font-size: 14px;
}

.chat-panel {
  background: white;
  color: var(--text);
  border-radius: 14px;
  overflow: hidden;
  min-width: 0;
}

.chat-header {
  background: #eaf1f8;
  padding: 18px;
  border-bottom: 1px solid var(--border);
}

.chat-header h3 { color: var(--navy); }
.chat-header p { color: var(--muted); font-size: 12px; }

.chat-messages {
  min-height: 190px;
  max-height: 270px;
  overflow-y: auto;
  padding: 18px;
}

.message {
  padding: 12px;
  border-radius: 9px;
  margin-bottom: 12px;
  font-size: 14px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.bot-message {
  background: #edf3f8;
  margin-right: 12px;
}

.user-message {
  background: #dcecff;
  margin-left: 12px;
}

.chat-input {
  display: flex;
  gap: 8px;
  padding: 13px;
  border-top: 1px solid var(--border);
}

.chat-input input {
  flex: 1;
  min-width: 0;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 7px;
  font-size: 14px;
}

.chat-input button {
  background: var(--blue);
  color: white;
  border: none;
  border-radius: 7px;
  padding: 0 17px;
  font-weight: bold;
  cursor: pointer;
}

.demo-note {
  padding: 10px 15px;
  color: #64748b;
  background: #f8fafc;
  font-size: 11px;
}

.learning-section { background: white; }

.learning-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

.learning-card {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 22px;
}

.learning-card h3 { color: var(--navy); }
.learning-card p {
  color: var(--muted);
  font-size: 14px;
  margin-top: 8px;
}

.about-box {
  background: white;
  padding: 30px;
  border-radius: 12px;
  border: 1px solid var(--border);
  max-width: 850px;
}

.about-box p {
  color: var(--muted);
  margin-top: 12px;
}

.contact-section {
  background: #e8eff6;
  text-align: center;
}

.contact-section p {
  color: var(--muted);
  margin: 10px 0 20px;
}

footer {
  background: #0a192b;
  color: white;
  padding: 35px 7%;
  text-align: center;
}

footer p {
  color: #aebfd0;
  font-size: 13px;
  margin-top: 8px;
}

@media(max-width:700px) {
  .nav-links { gap: 13px; }
  .nav-links a { font-size: 12px; }
  .hero { padding: 65px 7%; }
  .ai-layout { grid-template-columns: 1fr; }
  section { padding: 48px 6%; }
  .secondary-btn { margin: 12px 0 0; }
}
</style>
</head>

<body>

<header>
  <div class="navbar">
    <a href="#home" class="brand">
      <span class="brand-mark">P</span>
      PCM WORLDWIDE
    </a>

    <nav class="nav-links">
      <a href="#home">Home</a>
      <a href="#subjects">Subjects</a>
      <a href="#ai">AI Tutor</a>
      <a href="#learning">Resources</a>
      <a href="#about">About</a>
    </nav>
  </div>
</header>

<main>

<section class="hero" id="home">
  <div class="hero-content">
    <div class="eyebrow">A global learning community</div>

    <h1>Think. Discover. Understand.</h1>

    <p>
      Welcome to PCM Worldwide, a learning platform
      bringing Physics, Chemistry and Mathematics
      students together through knowledge, technology
      and innovation.
    </p>

    <a href="#subjects" class="primary-btn">
      Explore Subjects
    </a>

    <a href="#ai" class="secondary-btn">
      Meet the AI Tutor
    </a>
  </div>
</section>

<section id="subjects">
  <div class="section-heading">
    <h2>Explore Your Subjects</h2>
    <p>Build a strong foundation in the sciences and mathematics.</p>
  </div>

  <div class="subject-grid">

    <article class="subject-card">
      <div class="subject-symbol">PHY</div>
      <h3>Physics</h3>
      <p>
        Explore motion, forces, energy, electricity,
        waves, optics and the laws of nature.
      </p>
      <a class="text-link" href="#learning">Explore Physics</a>
    </article>

    <article class="subject-card">
      <div class="subject-symbol">CHEM</div>
      <h3>Chemistry</h3>
      <p>
        Understand atomic structure, bonding,
        reactions, organic chemistry and matter.
      </p>
      <a class="text-link" href="#learning">Explore Chemistry</a>
    </article>

    <article class="subject-card">
      <div class="subject-symbol">MATH</div>
      <h3>Mathematics</h3>
      <p>
        Develop skills in algebra, geometry,
        calculus, statistics and problem-solving.
      </p>
      <a class="text-link" href="#learning">Explore Mathematics</a>
    </article>

  </div>
</section>

<section class="ai-section" id="ai">
  <div class="section-heading">
    <h2>PCM AI Tutor</h2>
    <p>Intelligent learning assistance for curious minds.</p>
  </div>

  <div class="ai-layout">

    <div class="ai-description">
      <h3>Never stop asking questions.</h3>

      <p>
        The PCM AI Tutor is being developed to help
        students understand difficult topics, explore
        scientific ideas and improve their problem-solving
        skills.
      </p>

      <ul class="ai-features">
        <li>Step-by-step explanations</li>
        <li>Physics, Chemistry and Mathematics support</li>
        <li>Follow-up questions and concept clarification</li>
        <li>Worked examples and learning guidance</li>
      </ul>
    </div>

    <div class="chat-panel">
      <div class="chat-header">
        <h3>PCM AI Learning Assistant</h3>
        <p>AI connection coming in the next development stage</p>
      </div>

      <div class="chat-messages" id="messages">
        <div class="message bot-message">
          Welcome to PCM Worldwide. The AI Tutor interface
          is ready for development. Ask a sample question
          to see the demonstration.
        </div>
      </div>

      <form class="chat-input" id="chatForm">
        <input
          type="text"
          id="question"
          placeholder="Ask a PCM question..."
          required
        >
        <button type="submit">Send</button>
      </form>

      <div class="demo-note">
        Demonstration only. Real AI answers will be enabled
        after a secure AI service is connected.
      </div>
    </div>

  </div>
</section>

<section class="learning-section" id="learning">
  <div class="section-heading">
    <h2>Learning Resources</h2>
    <p>Our educational library will grow with every release.</p>
  </div>

  <div class="learning-grid">

    <article class="learning-card">
      <h3>Study Notes</h3>
      <p>Organised subject notes and explanations for students.</p>
    </article>

    <article class="learning-card">
      <h3>Practice Exercises</h3>
      <p>Questions designed to strengthen understanding.</p>
    </article>

    <article class="learning-card">
      <h3>Formula Library</h3>
      <p>Important mathematical and scientific formulas.</p>
    </article>

    <article class="learning-card">
      <h3>Learning Guides</h3>
      <p>Structured guidance for independent learning.</p>
    </article>

  </div>
</section>

<section id="about">
  <div class="section-heading">
    <h2>About PCM Worldwide</h2>
  </div>

  <div class="about-box">
    <h3>Our vision</h3>
    <p>
      PCM Worldwide is an educational technology initiative
      created to connect Physics, Chemistry and Mathematics
      students across the world.
    </p>
    <p>
      Our mission is to make learning accessible, encourage
      scientific thinking and create opportunities for
      students to learn and grow together.
    </p>
  </div>
</section>

<section class="contact-section" id="contact">
  <h2>Be Part of the Learning Community</h2>
  <p>Join us as we build a global destination for PCM education.</p>
  <a href="mailto:contact@pcmworldwide.com" class="primary-btn">
    Contact PCM Worldwide
  </a>
</section>

</main>

<footer>
  <h3>PCM WORLDWIDE</h3>
  <p>Connecting Minds. Building Knowledge. Shaping the Future.</p>
  <p>Version 1.0 | © 2026 PCM Worldwide</p>
</footer>

<script>
const chatForm = document.getElementById("chatForm");
const questionInput = document.getElementById("question");
const messages = document.getElementById("messages");

chatForm.addEventListener("submit", function(event) {
  event.preventDefault();

  const question = questionInput.value.trim();
  if (!question) return;

  const userMessage = document.createElement("div");
  userMessage.className = "message user-message";
  userMessage.textContent = question;
  messages.appendChild(userMessage);

  const botMessage = document.createElement("div");
  botMessage.className = "message bot-message";
  botMessage.textContent =
    "Thank you for your question. The PCM AI Tutor is currently in its interface development stage. A secure AI connection will be added in a future update.";
  messages.appendChild(botMessage);

  questionInput.value = "";
  messages.scrollTop = messages.scrollHeight;
});
</script>

</body>
</html>
