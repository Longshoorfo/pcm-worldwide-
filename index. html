<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>PCM Worldwide</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f4f7fb;
      color: #172033;
    }

    header {
      background: linear-gradient(135deg, #071b3d, #123c75);
      color: white;
      padding: 18px 20px;
      position: sticky;
      top: 0;
      z-index: 10;
      box-shadow: 0 2px 10px rgba(0,0,0,.15);
    }

    .nav {
      max-width: 1100px;
      margin: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 22px;
      font-weight: bold;
    }

    .logo span {
      color: #5ee7ff;
    }

    .menu {
      font-size: 14px;
      opacity: .9;
    }

    .hero {
      min-height: 520px;
      background: linear-gradient(135deg, #071b3d, #0c5fa8);
      color: white;
      display: flex;
      align-items: center;
      text-align: center;
      padding: 70px 20px;
    }

    .hero-content {
      max-width: 850px;
      margin: auto;
    }

    .badge {
      display: inline-block;
      background: rgba(255,255,255,.12);
      border: 1px solid rgba(255,255,255,.25);
      padding: 8px 15px;
      border-radius: 30px;
      margin-bottom: 22px;
      font-size: 14px;
    }

    .hero h1 {
      font-size: 48px;
      margin-bottom: 18px;
    }

    .hero h1 span {
      color: #5ee7ff;
    }

    .hero p {
      max-width: 680px;
      margin: auto;
      font-size: 18px;
      line-height: 1.7;
      color: #e3efff;
    }

    .buttons {
      margin-top: 30px;
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      text-decoration: none;
      padding: 14px 23px;
      border-radius: 9px;
      font-weight: bold;
      cursor: pointer;
      border: none;
      font-size: 15px;
    }

    .primary {
      background: #19c6e6;
      color: #04182c;
    }

    .secondary {
      color: white;
      border: 1px solid rgba(255,255,255,.5);
      background: transparent;
    }

    section {
      padding: 65px 20px;
    }

    .container {
      max-width: 1100px;
      margin: auto;
    }

    .section-title {
      text-align: center;
      margin-bottom: 40px;
    }

    .section-title h2 {
      font-size: 32px;
      margin-bottom: 10px;
    }

    .section-title p {
      color: #667085;
      line-height: 1.6;
    }

    .subjects {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .card {
      background: white;
      border-radius: 15px;
      padding: 30px 25px;
      box-shadow: 0 5px 22px rgba(20,40,80,.08);
      border: 1px solid #e9edf5;
    }

    .card-icon {
      font-size: 38px;
      margin-bottom: 18px;
    }

    .card h3 {
      font-size: 22px;
      margin-bottom: 10px;
    }

    .card p {
      color: #667085;
      line-height: 1.6;
      margin-bottom: 18px;
    }

    .study-btn {
      width: 100%;
      border: none;
      background: #edf7ff;
      color: #07549a;
      padding: 12px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
    }

    .features {
      background: #eaf3ff;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .feature {
      background: white;
      padding: 25px;
      border-radius: 12px;
    }

    .feature h3 {
      margin-bottom: 8px;
    }

    .feature p {
      color: #667085;
      line-height: 1.5;
    }

    .ai-section {
      background: #071b3d;
      color: white;
    }

    .ai-box {
      max-width: 760px;
      margin: auto;
      background: #102b54;
      border: 1px solid #244d7d;
      border-radius: 18px;
      padding: 30px;
    }

    .ai-box h2 {
      margin-bottom: 10px;
    }

    .ai-box > p {
      color: #cbdcf3;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .ai-box textarea {
      width: 100%;
      min-height: 110px;
      padding: 15px;
      border-radius: 10px;
      border: none;
      outline: none;
      resize: vertical;
      font-size: 16px;
    }

    .ask-btn {
      margin-top: 12px;
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 9px;
      background: #19c6e6;
      color: #04182c;
      font-weight: bold;
      cursor: pointer;
    }

    #answer {
      display: none;
      margin-top: 18px;
      background: #081d3c;
      padding: 18px;
      border-radius: 10px;
      line-height: 1.6;
    }

    .coming {
      text-align: center;
      background: white;
    }

    .coming-box {
      max-width: 750px;
      margin: auto;
      padding: 35px;
      background: #f4f8ff;
      border-radius: 15px;
    }

    .coming-box h2 {
      margin-bottom: 12px;
    }

    .coming-box p {
      color: #667085;
      line-height: 1.7;
    }

    footer {
      background: #031225;
      color: #9db1cc;
      text-align: center;
      padding: 35px 20px;
      line-height: 1.7;
    }

    footer strong {
      color: white;
    }

    @media (max-width: 750px) {
      .hero h1 {
        font-size: 37px;
      }

      .hero {
        min-height: 480px;
      }

      .subjects,
      .feature-grid {
        grid-template-columns: 1fr;
      }

      .menu {
        display: none;
      }

      section {
        padding: 50px 17px;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="nav">
    <div class="logo">PCM <span>Worldwide</span></div>
    <div class="menu">Learn • Practice • Connect</div>
  </div>
</header>

<main>

  <section class="hero">
    <div class="hero-content">

      <div class="badge">
        🌍 Built for PCM students worldwide
      </div>

      <h1>
        Master <span>Physics, Chemistry & Mathematics</span>
      </h1>

      <p>
        One learning platform where PCM students can study,
        revise, practise questions and build stronger skills
        together.
      </p>

      <div class="buttons">
        <a href="#subjects" class="btn primary">Start Learning</a>
        <a href="#ai" class="btn secondary">Ask PCM AI</a>
      </div>

    </div>
  </section>


  <section id="subjects">
    <div class="container">

      <div class="section-title">
        <h2>Choose Your Subject</h2>
        <p>
          Start studying the three core PCM subjects.
        </p>
      </div>

      <div class="subjects">

        <div class="card">
          <div class="card-icon">⚛️</div>
          <h3>Physics</h3>
          <p>
            Study mechanics, electricity, waves, energy,
            measurements and other important physics topics.
          </p>
          <button class="study-btn"
            onclick="showMessage('Physics')">
            Study Physics
          </button>
        </div>


        <div class="card">
          <div class="card-icon">🧪</div>
          <h3>Chemistry</h3>
          <p>
            Learn atomic structure, bonding, reactions,
            organic chemistry and more.
          </p>
          <button class="study-btn"
            onclick="showMessage('Chemistry')">
            Study Chemistry
          </button>
        </div>


        <div class="card">
          <div class="card-icon">📐</div>
          <h3>Mathematics</h3>
          <p>
            Practise algebra, geometry, calculus,
            trigonometry and problem solving.
          </p>
          <button class="study-btn"
            onclick="showMessage('Mathematics')">
            Study Mathematics
          </button>
        </div>

      </div>
    </div>
  </section>


  <section class="features">
    <div class="container">

      <div class="section-title">
        <h2>Everything in One Place</h2>
        <p>
          PCM Worldwide is being built to make studying simpler.
        </p>
      </div>

      <div class="feature-grid">

        <div class="feature">
          <h3>📚 Study Notes</h3>
          <p>
            Clear notes organised by subject and topic.
          </p>
        </div>

        <div class="feature">
          <h3>📝 Practice Questions</h3>
          <p>
            Test yourself and improve your problem-solving skills.
          </p>
        </div>

        <div class="feature">
          <h3>🤖 PCM AI</h3>
          <p>
            Get explanations and guidance when you're stuck.
          </p>
        </div>

      </div>

    </div>
  </section>


  <section class="ai-section" id="ai">

    <div class="ai-box">

      <h2>🤖 Ask PCM AI</h2>

      <p>
        Type a Physics, Chemistry or Mathematics question below.
        The full AI tutor is coming in a future upgrade.
      </p>

      <textarea
        id="question"
        placeholder="Example: Explain Newton's second law..."></textarea>

      <button class="ask-btn" onclick="askAI()">
        Ask Question
      </button>

      <div id="answer"></div>

    </div>

  </section>


  <section class="coming">

    <div class="coming-box">

      <h2>🚀 PCM Worldwide is Growing</h2>

      <p>
        This is Version 1. More study notes, quizzes,
        student accounts, progress tracking, discussions
        and real AI tutoring are planned for future versions.
      </p>

    </div>

  </section>

</main>


<footer>

  <strong>PCM Worldwide</strong>

  <br>

  Physics • Chemistry • Mathematics

  <br><br>

  © 2026 PCM Worldwide. All rights reserved.

</footer>


<script>

  function showMessage(subject) {
    alert(
      subject +
      " learning materials are being prepared for the next update!"
    );
  }


  function askAI() {

    const question =
      document.getElementById("question").value.trim();

    const answer =
      document.getElementById("answer");


    if (question === "") {

      answer.style.display = "block";

      answer.innerHTML =
        "Please type your PCM question first.";

      return;
    }


    answer.style.display = "block";

    answer.innerHTML =
      "<strong>PCM AI:</strong><br><br>" +
      "Your question has been received: <em>" +
      escapeHTML(question) +
      "</em><br><br>" +
      "The live AI tutor will be connected in a future version. " +
      "For Version 1, we're building the platform and study system first.";

  }


  function escapeHTML(text) {

    const div = document.createElement("div");

    div.textContent = text;

    return div.innerHTML;

  }

</script>

</body>
</html>
